# /etc/aiyt/app.env — настройки сервиса. После изменений: systemctl restart aiyt
NODE_ENV=production
PORT=8080
HOST=127.0.0.1
BASE_URL=https://buykurs.ru
DB_PATH=/var/lib/aiyt/app.db
APP_SECRET=заменяется-автоматически-при-установке
SECURE_COOKIES=1

# Первый администратор: при подтверждении этой почты аккаунт получает роль admin.
BOOTSTRAP_ADMIN_EMAIL=

# ЮKassa. mock — тестовый банк без шлюза (для показа); live — настоящий API.
# Для тестового магазина ЮKassa тоже ставьте live и тестовые shopId/ключ.
YOOKASSA_MODE=mock
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=

# Почта: log — письма пишутся в журнал службы (journalctl -u aiyt); unisender — Unisender Go.
MAIL_PROVIDER=log
MAIL_FROM="AI YT Studio <no-reply@buykurs.ru>"
UNISENDER_API_KEY=

# Вход через Google (Google Cloud Console → OAuth client ID, тип Web).
# Redirect URI: https://buykurs.ru/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

START_CREDITS=60
