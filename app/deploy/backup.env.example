# /etc/aiyt/backup.env — внешнее хранилище для резервных копий и уведомления.
# Права: chmod 600 /etc/aiyt/backup.env

# S3-хранилище (например, Timeweb Cloud → «Хранилище S3»: создайте бакет и ключи доступа; адрес — в панели).
S3_ENDPOINT=https://s3.timeweb.cloud
S3_REGION=ru-1
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Пароль шифрования копий (длинный, храните отдельно — без него копию не расшифровать).
# Расшифровка: openssl enc -d -aes-256-cbc -pbkdf2 -iter 200000 -in файл.enc -out app.db.gz
BACKUP_PASSPHRASE=

# Уведомления в Telegram: создайте бота у @BotFather, напишите ему что-нибудь,
# chat_id можно узнать у @userinfobot.
TG_BOT_TOKEN=
TG_CHAT_ID=
